---
import Sidebar from '../components/Sidebar.astro';
import { siteConfig } from '../site';
const { title = siteConfig.name, description = siteConfig.intro } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <title>{title === siteConfig.name ? title : `${title} · ${siteConfig.name}`}</title>
  <script is:inline>
    (() => {
      const saved = localStorage.getItem('theme');
      const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    })();
  </script>
  <style is:global>
    :root {
      --bg:#f4f4f1; --panel:rgba(255,255,255,.72); --text:#1d1f20; --muted:#707477;
      --line:rgba(20,24,28,.12); --soft:#e8e8e3; --shadow:0 24px 70px rgba(27,30,33,.08);
      --radius:22px; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    }
    :root[data-theme="dark"] { --bg:#111315; --panel:rgba(26,29,31,.78); --text:#f1f2ef; --muted:#a5aaad; --line:rgba(255,255,255,.1); --soft:#202326; --shadow:0 24px 70px rgba(0,0,0,.25); }
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--bg);color:var(--text);min-height:100vh;background-image:radial-gradient(circle at 80% 10%,rgba(130,130,120,.08),transparent 32%)} a{color:inherit;text-decoration:none}
    .sidebar{position:fixed;inset:0 auto 0 0;width:260px;padding:42px 34px;border-right:1px solid var(--line);display:flex;flex-direction:column;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px);z-index:10}
    .brand{font-weight:800;font-size:28px;letter-spacing:-1.5px}.brand-wrap p{margin:8px 0 36px;color:var(--muted);font-size:12px;line-height:1.7}.sidebar nav{display:flex;flex-direction:column;gap:8px}.sidebar nav a{padding:11px 13px;border-radius:12px;color:var(--muted);font-size:14px;transition:.2s}.sidebar nav a:hover,.sidebar nav a.active{background:var(--soft);color:var(--text);transform:translateX(2px)}
    .side-bottom{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px}.socials{display:flex;gap:10px;font-size:12px;color:var(--muted)}.theme-toggle{border:1px solid var(--line);background:var(--panel);color:var(--text);width:38px;height:38px;border-radius:50%;cursor:pointer}
    main{margin-left:260px;min-height:100vh}.shell{max-width:1120px;margin:0 auto;padding:64px 54px 90px}.eyebrow{display:flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.16em;color:var(--muted);font-size:11px;font-weight:700}.eyebrow::before{content:"";width:28px;height:1px;background:var(--muted)}
    .hero{padding:58px 0 46px}.hero h1{max-width:850px;font-size:clamp(48px,7vw,92px);line-height:.96;letter-spacing:-.06em;margin:20px 0 28px}.hero p{max-width:680px;color:var(--muted);font-size:18px;line-height:1.85}
    .grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:26px;backdrop-filter:blur(12px)}
    .post-card{grid-column:span 6;min-height:250px;display:flex;flex-direction:column;transition:.25s ease}.post-card:hover{transform:translateY(-4px)}.meta{display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:12px}.post-card h2{font-size:26px;letter-spacing:-.035em;margin:23px 0 12px;line-height:1.25}.post-card p{margin:0;color:var(--muted);line-height:1.7}.post-card .more{margin-top:auto;padding-top:28px;font-weight:700;font-size:13px}
    .section-head{display:flex;justify-content:space-between;align-items:end;margin:58px 0 22px}.section-head h2{font-size:28px;margin:0;letter-spacing:-.03em}.section-head a{color:var(--muted);font-size:13px}.stats{grid-column:span 4}.stats strong{display:block;font-size:38px;letter-spacing:-.04em}.stats span{color:var(--muted);font-size:12px}
    .page-title{padding:48px 0 28px}.page-title h1{font-size:clamp(44px,7vw,78px);letter-spacing:-.055em;margin:12px 0 16px}.page-title p{color:var(--muted);max-width:620px;line-height:1.75}
    .list{display:flex;flex-direction:column;border-top:1px solid var(--line)}.list-item{display:grid;grid-template-columns:110px 1fr auto;align-items:center;gap:24px;padding:25px 4px;border-bottom:1px solid var(--line)}.list-item time,.list-item .cat{color:var(--muted);font-size:12px}.list-item h2{margin:0;font-size:20px;letter-spacing:-.02em}
    .chips{display:flex;flex-wrap:wrap;gap:10px}.chip{padding:9px 13px;background:var(--soft);border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:12px}.article-wrap{max-width:820px}.article-head{padding:54px 0 28px;border-bottom:1px solid var(--line)}.article-head h1{font-size:clamp(42px,6vw,70px);letter-spacing:-.055em;line-height:1.03;margin:18px 0 24px}
    article{font-size:17px;line-height:1.9;padding:34px 0}article h2{margin-top:2.2em;font-size:30px;letter-spacing:-.03em}article h3{margin-top:1.8em;font-size:22px}article p,article li{color:color-mix(in srgb,var(--text) 88%,var(--muted))}article blockquote{border-left:3px solid var(--text);margin:24px 0;padding:4px 0 4px 20px;color:var(--muted)}article pre{overflow:auto;padding:20px;border-radius:16px}article code:not(pre code){padding:.15em .4em;background:var(--soft);border-radius:6px;font-size:.9em}
    .note{padding:18px 20px;border-radius:16px;background:var(--soft);color:var(--muted);font-size:13px;line-height:1.7}.search-box{width:100%;border:1px solid var(--line);background:var(--panel);color:var(--text);padding:17px 18px;border-radius:16px;font:inherit;outline:none}.search-box:focus{border-color:var(--muted)}.search-results{margin-top:22px}
    footer{margin-top:68px;padding-top:22px;border-top:1px solid var(--line);color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:20px}
    @media(max-width:820px){.sidebar{position:static;width:auto;height:auto;padding:22px;border-right:0;border-bottom:1px solid var(--line);flex-direction:row;align-items:center;justify-content:space-between;gap:16px;overflow-x:auto}.brand-wrap p,.side-bottom{display:none}.brand{font-size:20px;white-space:nowrap}.sidebar nav{flex-direction:row;gap:4px}.sidebar nav a{white-space:nowrap;padding:8px 10px}main{margin-left:0}.shell{padding:32px 22px 64px}.hero{padding-top:38px}.post-card,.stats{grid-column:span 12}.list-item{grid-template-columns:1fr;gap:7px}}
  </style>
</head>
<body>
  <Sidebar />
  <main><div class="shell"><slot /><footer><span>{siteConfig.footer}</span><span>© {new Date().getFullYear()} {siteConfig.name}</span></footer></div></main>
  <script is:inline>
    document.addEventListener('click',(e)=>{const btn=e.target.closest('#theme-toggle');if(!btn)return;const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('theme',next);});
  </script>
</body>
</html>
