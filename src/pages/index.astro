---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site';
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => +b.data.pubDate - +a.data.pubDate);
const featured = posts.filter(p => p.data.featured).slice(0,4);
const shown = featured.length ? featured : posts.slice(0,4);
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
const categories = [...new Set(posts.map(p => p.data.category))];
const dateFmt = new Intl.DateTimeFormat('zh-CN', {year:'numeric',month:'2-digit',day:'2-digit'});
---
<BaseLayout title={siteConfig.name}>
  <section class="hero"><div class="eyebrow">Personal Research Site</div><h1>探索工程中的<br/>智能预测。</h1><p>{siteConfig.intro}</p></section>
  <div class="grid"><div class="card stats"><strong>{posts.length}</strong><span>文章 ARTICLES</span></div><div class="card stats"><strong>{tags.length}</strong><span>标签 TAGS</span></div><div class="card stats"><strong>{categories.length}</strong><span>分类 CATEGORIES</span></div></div>
  <div class="section-head"><h2>最近文章</h2><a href={`${base}blog/`}>查看全部 →</a></div>
  <div class="grid">{shown.map(post => <a class="card post-card" href={`${base}blog/${post.id}/`}><div class="meta"><span>{post.data.category}</span><span>·</span><time>{dateFmt.format(post.data.pubDate)}</time></div><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="more">阅读全文 →</div></a>)}</div>
  <div class="section-head"><h2>研究方向</h2></div>
  <div class="chips"><span class="chip">Solid Rocket Motor</span><span class="chip">Deep Learning</span><span class="chip">Meta Learning</span><span class="chip">Small-Sample Learning</span><span class="chip">Engineering AI</span></div>
</BaseLayout>
