---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const reports = (await getCollection('blog', ({ data }) => !data.draft && data.category === '周报'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="周报" description="记录每周科研、开发与学习进展。">
  <header class="page-title">
    <div class="eyebrow">Weekly Reports</div>
    <h1>周报</h1>
    <p>同一份周报可以普通阅读，也可以切换到 16:9 HTML 汇报模式。</p>
  </header>

  {reports.length > 0 ? (
    <div class="list">
      {reports.map((report) => (
        <div class="list-item weekly-item">
          <time>{report.data.pubDate.toLocaleDateString('zh-CN')}</time>
          <div>
            <h2>{report.data.title}</h2>
            <p style="margin:.45rem 0 0;color:var(--muted);line-height:1.65">{report.data.description}</p>
          </div>
          <div class="weekly-actions">
            <a class="weekly-button" href={`${base}blog/${report.id}/`}>阅读</a>
            <a class="weekly-button primary" href={`${base}slides/${report.id}/`}>汇报</a>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="card">
      <h2 style="margin-top:0">还没有周报</h2>
      <p style="color:var(--muted);line-height:1.8">在 <code>src/content/blog/</code> 新建 Markdown，并把 <code>category</code> 设置为 <code>周报</code>，发布后会自动显示在这里。</p>
    </div>
  )}

  <style>
    .weekly-actions{display:flex;gap:8px;justify-content:flex-end;align-items:center;flex-wrap:wrap}
    .weekly-button{display:inline-flex;align-items:center;justify-content:center;padding:9px 13px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:12px;background:var(--panel);transition:.2s}
    .weekly-button:hover{color:var(--text);transform:translateY(-1px)}
    .weekly-button.primary{background:var(--text);color:var(--bg);border-color:var(--text)}
    @media(max-width:820px){.weekly-actions{justify-content:flex-start}}
  </style>
</BaseLayout>
