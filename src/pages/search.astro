---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL;
const posts=(await getCollection('blog',({data})=>!data.draft)).map(p=>({id:p.id,title:p.data.title,description:p.data.description,category:p.data.category}));
---
<BaseLayout title="搜索"><header class="page-title"><div class="eyebrow">Search</div><h1>搜索</h1><p>搜索标题、简介和分类。</p></header><input id="q" class="search-box" placeholder="例如：LSTM、火箭发动机、小样本学习…" autocomplete="off"/><div id="results" class="list search-results"></div>
<script define:vars={{posts,base}} is:inline>
const q=document.querySelector('#q'),box=document.querySelector('#results');
const render=(term='')=>{const k=term.trim().toLowerCase();const data=k?posts.filter(p=>[p.title,p.description,p.category].join(' ').toLowerCase().includes(k)):posts;box.innerHTML=data.map(p=>`<a class="list-item" href="${base}blog/${p.id}/"><span class="cat">${p.category}</span><h2>${p.title}</h2><span class="cat">阅读全文 →</span></a>`).join('')||'<p style="color:var(--muted)">没有找到相关内容。</p>';};q.addEventListener('input',()=>render(q.value));render();
</script></BaseLayout>
