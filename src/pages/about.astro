---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site';
---
<BaseLayout title="关于"><header class="page-title"><div class="eyebrow">About</div><h1>关于我</h1><p>{siteConfig.intro}</p></header><div class="card" style="max-width:760px"><h2>研究方向</h2><p style="color:var(--muted);line-height:1.9">固体火箭发动机性能预测、深度学习、元学习、小样本学习与工程智能。这里可以继续补充教育经历、论文、获奖情况、联系方式与个人简介。</p><div class="chips" style="margin-top:24px"><span class="chip">Email: {siteConfig.email}</span><a class="chip" href={siteConfig.github}>GitHub</a></div></div></BaseLayout>
