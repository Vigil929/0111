---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../site';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const reports = await getCollection('blog', ({ data }) => !data.draft && data.category === '周报');
  return reports.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const renderedHtml = post.rendered?.html ?? '';
const bodySlides = renderedHtml
  .split(/<hr\s*\/?\s*>/i)
  .map((slide) => slide.trim())
  .filter(Boolean);
const totalSlides = bodySlides.length + 1;
const dateFmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={post.data.description} />
  <title>{post.data.title} · 汇报模式</title>
  <style>
    :root {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      color: #17191b;
      background: #0e1012;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; }
    body { background: radial-gradient(circle at 75% 15%, #262b30 0, #111417 34%, #090b0d 100%); }
    button, a { font: inherit; }
    .deck { position: relative; width: 100vw; height: 100vh; }
    .slide {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 5vh 5vw 8vh;
    }
    .slide[hidden] { display: none; }
    .frame {
      width: min(90vw, 1500px);
      aspect-ratio: 16 / 9;
      max-height: 84vh;
      overflow: auto;
      background: #f5f5f0;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 22px;
      box-shadow: 0 35px 100px rgba(0,0,0,.46);
      padding: clamp(36px, 5vw, 78px);
      position: relative;
    }
    .cover .frame {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background:
        linear-gradient(135deg, rgba(255,255,255,.95), rgba(235,236,230,.94)),
        radial-gradient(circle at 80% 20%, rgba(20,24,28,.12), transparent 32%);
    }
    .kicker { font-size: 13px; text-transform: uppercase; letter-spacing: .18em; color: #74797c; font-weight: 700; }
    .cover h1 { margin: 0; max-width: 1100px; font-size: clamp(46px, 6vw, 94px); line-height: .98; letter-spacing: -.055em; }
    .cover p { margin: 20px 0 0; max-width: 820px; font-size: clamp(18px, 2vw, 28px); line-height: 1.65; color: #666b6f; }
    .cover-meta { display: flex; justify-content: space-between; gap: 24px; color: #6f7477; font-size: 15px; }
    .slide-content { width: 100%; height: 100%; overflow: auto; }
    .slide-content :global(h1), .slide-content :global(h2) {
      margin: 0 0 .6em;
      letter-spacing: -.04em;
      line-height: 1.08;
    }
    .slide-content :global(h1) { font-size: clamp(44px, 5.6vw, 82px); }
    .slide-content :global(h2) { font-size: clamp(38px, 4.5vw, 66px); }
    .slide-content :global(h3) { margin: 1.1em 0 .5em; font-size: clamp(24px, 2.5vw, 38px); }
    .slide-content :global(p), .slide-content :global(li) {
      font-size: clamp(18px, 1.7vw, 28px);
      line-height: 1.62;
      color: #3f4448;
    }
    .slide-content :global(ul), .slide-content :global(ol) { padding-left: 1.3em; }
    .slide-content :global(li) { margin: .35em 0; }
    .slide-content :global(strong) { color: #111417; }
    .slide-content :global(blockquote) {
      margin: 1.2em 0;
      padding: .15em 0 .15em 1em;
      border-left: 4px solid #17191b;
      color: #555b5f;
    }
    .slide-content :global(img) {
      display: block;
      max-width: 100%;
      max-height: 48vh;
      margin: 1.2rem auto;
      object-fit: contain;
      border-radius: 12px;
    }
    .slide-content :global(table) { width: 100%; border-collapse: collapse; font-size: clamp(15px, 1.3vw, 22px); }
    .slide-content :global(th), .slide-content :global(td) { padding: .65em .8em; border-bottom: 1px solid #cfd2d0; text-align: left; }
    .slide-content :global(pre) { overflow: auto; padding: 18px; border-radius: 12px; background: #17191b; color: #f4f4ef; font-size: clamp(14px, 1.15vw, 19px); }
    .slide-content :global(code:not(pre code)) { background: #e5e6e1; padding: .12em .35em; border-radius: 5px; }
    .controls {
      position: fixed;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px;
      border-radius: 999px;
      background: rgba(19,22,24,.76);
      border: 1px solid rgba(255,255,255,.12);
      backdrop-filter: blur(14px);
      color: #eef0ec;
      z-index: 20;
    }
    .controls button, .controls a {
      border: 0;
      color: inherit;
      background: transparent;
      padding: 8px 12px;
      border-radius: 999px;
      cursor: pointer;
      text-decoration: none;
      font-size: 13px;
    }
    .controls button:hover, .controls a:hover { background: rgba(255,255,255,.1); }
    .counter { min-width: 58px; text-align: center; color: #aeb3b5; font-size: 12px; }
    .progress { position: fixed; left: 0; bottom: 0; width: 100%; height: 3px; background: rgba(255,255,255,.08); z-index: 30; }
    .progress > span { display: block; height: 100%; width: 0; background: #f1f2ee; transition: width .2s ease; }
    .hint { position: fixed; top: 16px; right: 18px; color: #92989b; font-size: 11px; z-index: 20; }
    @media (max-aspect-ratio: 4/3) {
      .slide { padding: 3vh 4vw 10vh; }
      .frame { width: 92vw; height: 82vh; aspect-ratio: auto; padding: 34px 28px; }
      .cover-meta { flex-direction: column; gap: 6px; }
      .hint { display: none; }
    }
    @media print {
      html, body { overflow: visible; background: white; }
      .deck { height: auto; }
      .slide, .slide[hidden] { position: static; display: grid !important; height: 100vh; page-break-after: always; padding: 0; }
      .frame { width: 100%; height: 100%; max-height: none; border-radius: 0; box-shadow: none; border: 0; overflow: hidden; }
      .controls, .hint, .progress { display: none; }
    }
  </style>
</head>
<body>
  <div class="deck" id="deck">
    <section class="slide cover" data-slide="0">
      <div class="frame">
        <div>
          <div class="kicker">Weekly Research Presentation</div>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
        </div>
        <div class="cover-meta">
          <span>{siteConfig.name}</span>
          <span>{dateFmt.format(post.data.pubDate)}</span>
        </div>
      </div>
    </section>

    {bodySlides.map((slide, index) => (
      <section class="slide" data-slide={index + 1} hidden>
        <div class="frame">
          <div class="slide-content" set:html={slide} />
        </div>
      </section>
    ))}
  </div>

  <div class="hint">← → / Space 翻页 · F 全屏 · P 打印</div>
  <div class="controls">
    <a href={`${base}blog/${post.id}/`}>阅读</a>
    <button type="button" data-action="prev" aria-label="上一页">←</button>
    <span class="counter" id="counter">1 / {totalSlides}</span>
    <button type="button" data-action="next" aria-label="下一页">→</button>
    <button type="button" data-action="fullscreen">全屏</button>
  </div>
  <div class="progress"><span id="progress-bar"></span></div>

  <script is:inline>
    (() => {
      const slides = [...document.querySelectorAll('.slide')];
      const counter = document.querySelector('#counter');
      const progress = document.querySelector('#progress-bar');
      let current = Math.max(0, Math.min(slides.length - 1, Number(location.hash.slice(1)) - 1 || 0));

      const show = (index) => {
        current = Math.max(0, Math.min(slides.length - 1, index));
        slides.forEach((slide, i) => { slide.hidden = i !== current; });
        counter.textContent = `${current + 1} / ${slides.length}`;
        progress.style.width = `${((current + 1) / slides.length) * 100}%`;
        history.replaceState(null, '', `#${current + 1}`);
      };

      const next = () => show(current + 1);
      const prev = () => show(current - 1);
      const toggleFullscreen = async () => {
        if (!document.fullscreenElement) await document.documentElement.requestFullscreen?.();
        else await document.exitFullscreen?.();
      };

      document.addEventListener('click', (event) => {
        const action = event.target.closest('[data-action]')?.dataset.action;
        if (action === 'next') next();
        if (action === 'prev') prev();
        if (action === 'fullscreen') toggleFullscreen();
      });

      document.addEventListener('keydown', (event) => {
        if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(event.key)) {
          event.preventDefault();
          next();
        } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(event.key)) {
          event.preventDefault();
          prev();
        } else if (event.key === 'Home') {
          show(0);
        } else if (event.key === 'End') {
          show(slides.length - 1);
        } else if (event.key.toLowerCase() === 'f') {
          toggleFullscreen();
        } else if (event.key.toLowerCase() === 'p') {
          window.print();
        }
      });

      let startX = null;
      document.addEventListener('pointerdown', (event) => { startX = event.clientX; });
      document.addEventListener('pointerup', (event) => {
        if (startX === null) return;
        const delta = event.clientX - startX;
        if (Math.abs(delta) > 70) delta < 0 ? next() : prev();
        startX = null;
      });

      show(current);
    })();
  </script>
</body>
</html>
