---
import { siteConfig } from '../site';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  ['首页', `${base}`],
  ['文章', `${base}blog/`],
  ['项目', `${base}projects/`],
  ['周报', `${base}weekly/`],
  ['关于', `${base}about/`],
  ['搜索', `${base}search/`]
];
---
<aside class="sidebar">
  <div class="brand-wrap">
    <div class="brand-row">
      <img class="avatar" src={`${base}images/avatar.svg`} alt={`${siteConfig.name} 的头像`} />
      <a class="brand" href={base}>{siteConfig.name}</a>
    </div>
    <p>{siteConfig.subtitle}</p>
  </div>
  <nav>
    {nav.map(([label, href]) => (
      <a class:list={{active: href === base ? path === base : path.startsWith(href)}} href={href}>{label}</a>
    ))}
  </nav>
  <div class="side-bottom">
    <div class="socials">
      <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={siteConfig.scholar}>Scholar</a>
    </div>
    <button class="theme-toggle" id="theme-toggle" aria-label="切换主题">◐</button>
  </div>
</aside>

<style>
  .brand-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
  }

  @media (max-width: 820px) {
    .avatar {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }
  }
</style>
